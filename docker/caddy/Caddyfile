# Trackarr Production Caddyfile
# Automatic HTTPS with Let's Encrypt

{
	# Global options
	email {$ACME_EMAIL:admin@example.com}
	
	# Use staging for testing (remove in production)
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# Main application
{$DOMAIN:localhost} {
	# Security headers
	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		-Server
	}

	# Compression
	encode gzip zstd

	# Rate limiting (basic)
	# For advanced rate limiting, use the app's built-in Redis-backed limiter

	# Reverse proxy to Nuxt app
	reverse_proxy trackarr-app:3000 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		
		# Health checks
		health_uri /api/health
		health_interval 30s
		health_timeout 10s
	}

	# Logging
	log {
		output file /var/log/caddy/access.log {
			roll_size 100mb
			roll_keep 10
			roll_keep_for 720h
		}
		format filter {
			wrap json
			fields {
				# Passkeys travel in query strings: keep them out of access logs
				request>uri query {
					delete passkey
					delete apikey
				}
			}
		}
	}
}

# Tracker announce endpoint (separate subdomain or port)
{$TRACKER_DOMAIN:tracker.localhost} {
	# Minimal headers for tracker
	header {
		-Server
		X-Content-Type-Options "nosniff"
	}

	# Tracker endpoints
	reverse_proxy trackarr-tracker:8080 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
	}

	log {
		output file /var/log/caddy/tracker.log {
			roll_size 100mb
			roll_keep 5
		}
		format filter {
			wrap json
			fields {
				# Passkeys travel in query strings: keep them out of access logs
				request>uri query {
					delete passkey
					delete apikey
				}
			}
		}
	}
}

# Monitoring: Beszel (host and container monitoring, alerts)
{$MONITORING_DOMAIN:monitoring.localhost} {
	# No basic auth: the Beszel UI sends its own token in the Authorization
	# header, which basic auth rejects, so the browser asks again and again.
	# Beszel's login protects it; its account is created from .env on the
	# first start (BESZEL_ADMIN_EMAIL / BESZEL_ADMIN_PASSWORD).
	# Never let a visitor create the first account
	respond /api/beszel/create-user 403

	reverse_proxy trackarr-beszel:8090
}
