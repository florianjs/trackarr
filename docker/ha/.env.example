# Trackarr replicated deployment - one .env per site
# Example: 3 sites on a WireGuard network 10.8.0.0/24
#   dc1 = 10.8.0.1 (app site, initial primary)
#   dc2 = 10.8.0.2 (app site, standby)
#   dc3 = 10.8.0.3 (witness: etcd + sentinel only)

# --- This site ----------------------------------------------------------------
NODE_NAME=dc1
# Address of this machine on the private network between sites
NODE_IP=10.8.0.1
# "node" on app sites, empty on the witness
COMPOSE_PROFILES=node

# --- Same value on every site -------------------------------------------------
ETCD_INITIAL_CLUSTER=dc1=http://10.8.0.1:2380,dc2=http://10.8.0.2:2380,dc3=http://10.8.0.3:2380
ETCD3_HOSTS='"10.8.0.1:2379","10.8.0.2:2379","10.8.0.3:2379"'
PG_HOSTS=10.8.0.1:5432,10.8.0.2:5432
REDIS_SENTINELS=10.8.0.1:26379,10.8.0.2:26379,10.8.0.3:26379
# Only used on first start, Sentinel decides afterwards
REDIS_INITIAL_MASTER_IP=10.8.0.1

# Passwords go into connection URLs: use URL-safe values (openssl rand -hex 24)
PG_SUPERUSER_PASSWORD=change-me
PG_REPLICATION_PASSWORD=change-me
PG_ADMIN_PASSWORD=change-me
DB_USER=tracker
DB_PASSWORD=change-me
DB_NAME=trackarr
REDIS_PASSWORD=change-me
# Sentinels and etcd require authentication too (clients and the other sites)
REDIS_SENTINEL_PASSWORD=change-me
ETCD_ROOT_PASSWORD=change-me
ETCD_PATRONI_PASSWORD=change-me
# Patroni REST API: needed for switchover, restart, reinitialize
PATRONI_API_PASSWORD=change-me
# At least 32 random characters (openssl rand -hex 32); the app refuses shorter
NUXT_SESSION_SECRET=change-me
# At least 32 random characters (openssl rand -hex 32)
IP_HASH_SECRET=change-me
# App <-> tracker service private API (openssl rand -hex 32)
TRACKER_INTERNAL_TOKEN=change-me

# --- Public endpoints ---------------------------------------------------------
# Main site: DNS record switched to the surviving site on failover
DOMAIN=tracker.example.com
# Tracker hostname served by THIS site (dc1: tracker1..., dc2: tracker2...)
TRACKER_DOMAIN=tracker1.example.com
# Same on every site: primary tracker, then the other sites as fallback tiers.
# Clients switch to the next one on their own when a site is down.
TRACKER_HTTP_URL=https://tracker1.example.com/announce
TRACKER_BACKUP_HTTP_URLS=https://tracker2.example.com/announce
ACME_EMAIL=admin@example.com
